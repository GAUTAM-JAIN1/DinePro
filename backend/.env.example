PORT=5000
NODE_ENV=development

# Frontend origin(s) allowed to call this API (comma separated, no trailing slash)
#   local:  http://localhost:5173
#   prod:   https://your-app.vercel.app
CLIENT_ORIGINS=http://localhost:5173

# Optional: allow Vercel preview deployments (https://<prefix>*.vercel.app)
# ALLOW_VERCEL_PREVIEWS=true
# VERCEL_PREVIEW_PREFIX=dinepro-

FIREBASE_PROJECT_ID=your_project_id_here

# Local development: path to the service account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Render / production: paste the whole service account JSON on ONE line instead
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
