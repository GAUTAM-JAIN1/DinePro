# Backend (Render) URL — no trailing slash
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Optional: only set if QR codes must point to a different domain than this app
# VITE_CUSTOMER_APP_URL=https://your-app.vercel.app

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Local testing only: each browser tab keeps its own login (Chef in one tab, Receptionist in another)
# VITE_AUTH_PERSISTENCE=session
